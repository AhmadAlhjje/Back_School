# ═══ Server (VPS) configuration for docker-compose.yml ═══════════════════
# Create .env from this file on the server with:   bash docker/init-env.sh
# (random passwords and secrets, and it asks for the first super admin account).
# After changing .env, apply it with:              docker compose up -d --build

# ─── Addresses ─────────────────────────────────────────────────────────
# Public IP (or domain) of the server
SERVER_ADDRESS=163.245.221.210
# The API: the student app connects to http://SERVER_ADDRESS:API_PORT
API_PORT=6003
# The dashboards (their own projects): allowed to call the API
OWNER_DASHBOARD_PORT=6001
ADMIN_DASHBOARD_PORT=6002

# ─── Database (created and migrated automatically) ─────────────────────
DB_DATABASE=edu_institute
DB_USERNAME=edu
# Fixed when the database is first created — do not change them afterwards.
DB_PASSWORD=CHANGE_ME
DB_ROOT_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# ─── Secrets — never change them once the platform is in use ───────────
# (everyone would be signed out and processed videos could no longer be played)
JWT_ACCESS_SECRET=CHANGE_ME
MEDIA_TOKEN_SECRET=CHANGE_ME
MEDIA_KEY_ENCRYPTION_KEY=CHANGE_ME

# ─── First super admin (created on the first start, never changed afterwards) ─
SEED_SUPER_ADMIN_NAME=
SEED_SUPER_ADMIN_PHONE=
SEED_SUPER_ADMIN_PASSWORD=

# ─── Videos ────────────────────────────────────────────────────────────
# Qualities produced for each uploaded video. 360+720 is clear for lessons and prepares videos
# about twice as fast as 360,720,1080 (add 1080 back if you need it).
HLS_RENDITIONS=360,720
MAX_VIDEO_SIZE_GB=20
MAX_FILE_SIZE_MB=200
# Videos processed at the same time
VIDEO_WORKER_CONCURRENCY=1

# ─── Daily database backup into ./backups (time in UTC) ────────────────
BACKUP_TIME=02:30
