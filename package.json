{
  "name": "@edu/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Educational institute platform — REST API, background jobs and database (migrations, seeders)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "tsx --env-file-if-exists=.env database/cli.ts setup",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "worker": "node --env-file-if-exists=.env dist/workers/index.js",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/workers/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env database/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env database/cli.ts seed",
    "db:fresh": "tsx --env-file-if-exists=.env database/cli.ts fresh",
    "db:make-migration": "prisma migrate dev",
    "db:status": "prisma migrate status",
    "db:generate": "prisma generate",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-super-admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx --env-file-if-exists=.env scripts/e2e-flow.ts",
    "app:live-setup": "tsx --env-file-if-exists=.env scripts/app-live-setup.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "bullmq": "5.81.5",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "mariadb": "3.4.7",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "rate-limit-redis": "6.0.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/busboy": "1.5.4",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.6",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "mariadb": "3.4.7",
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  }
}
