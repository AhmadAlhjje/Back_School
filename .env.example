# ═══ Backend configuration ═══════════════════════════════════════════════
# `npm run dev` creates the database, applies the migrations and (when empty) runs the seeders.

# ─── Server ────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of this API: used in the video/file links sent to the app and the dashboards
API_BASE_URL=http://localhost:4000
# Dashboards allowed to call the API (institute_dashboard: 5173, super_admin_web: 5174)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Proxies in front of the API: a count (1 behind one Nginx) or addresses such as uniquelocal (Docker)
TRUST_PROXY=0
LOG_LEVEL=info

# ─── Database (XAMPP MySQL: user root, empty password) ─────────────────
# Write the database name you want: it is created and migrated automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edu_institute
DB_USERNAME=root
DB_PASSWORD=

# ─── Background jobs ───────────────────────────────────────────────────
# Empty: video processing and notifications run inside the API (only MySQL needed).
# Production: redis://:password@host:6379 and run `npm run worker` as a second process.
REDIS_URL=

# ─── Secrets (generate: openssl rand -hex 32; key: openssl rand -base64 32) ─
JWT_ACCESS_SECRET=CHANGE_ME
MEDIA_TOKEN_SECRET=CHANGE_ME
# Encrypts every video's key. Keep it: without it processed videos cannot be played.
MEDIA_KEY_ENCRYPTION_KEY=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90
# true when the API is served over HTTPS (secure cookies)
COOKIE_SECURE=false

# ─── Storage & video processing ────────────────────────────────────────
# Private folder for videos and files (created automatically, never served directly)
STORAGE_PATH=./storage
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
UPLOAD_CHUNK_SIZE_MB=8
MAX_VIDEO_SIZE_GB=20
MAX_FILE_SIZE_MB=200
KEEP_ORIGINAL_VIDEOS=false
HLS_RENDITIONS=360,720,1080
HLS_SEGMENT_SECONDS=6
FFMPEG_PRESET=veryfast
VIDEO_WORKER_CONCURRENCY=1
# Production behind Nginx: true (Nginx streams authorized media via X-Accel-Redirect)
MEDIA_ACCEL_REDIRECT=false
MEDIA_ACCEL_PREFIX=/protected-media

# ─── Seeders ───────────────────────────────────────────────────────────
SEED_SUPER_ADMIN_NAME=مدير النظام
SEED_SUPER_ADMIN_PHONE=0900000000
SEED_SUPER_ADMIN_PASSWORD=Admin12345
# Demo catalog, owner, students, sample video and PDFs (never enable in production)
SEED_DEMO_DATA=true

# ─── API docs (Swagger UI at /api/docs) ────────────────────────────────
ENABLE_API_DOCS=true
