# Dependencies and build output
node_modules/
dist/
coverage/
src/generated/

# Local environment (.env.example, .env.test and .env.production.example are committed).
# On the server, .env is the production configuration (docker/init-env.sh).
.env

# Runtime data — anchored with "/" so only these root folders are ignored,
# never source folders with the same name (src/core/storage is code).
/storage/
/storage-test/
/tests/.fixtures/
# Database dumps written by the backup container on the server
/backups/

*.log
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
