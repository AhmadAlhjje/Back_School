# Copy to backend/deploy/.env and fill in every CHANGE_ME. Never commit it.
# Generate secrets with:  openssl rand -hex 32        (hex keeps URLs and shells safe)

# ─── Domains (DNS A/AAAA records must point to this server) ──────────────
API_DOMAIN=api.example.com
OWNER_DOMAIN=dashboard.example.com
ADMIN_DOMAIN=admin.example.com
# Email for Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=admin@example.com

IMAGE_TAG=latest
LOG_LEVEL=info

# ─── MySQL (letters and digits only recommended for passwords) ──────────
MYSQL_DATABASE=edu_platform
MYSQL_USER=edu_app
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

# ─── Redis ────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME

# ─── Auth & media secrets ─────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME
MEDIA_TOKEN_SECRET=CHANGE_ME
# 32 bytes, base64:  openssl rand -base64 32
# Encrypts every video's AES key at rest. Losing it makes all processed videos unplayable:
# store it in a password manager together with the backups (docs/backup.md).
MEDIA_KEY_ENCRYPTION_KEY=CHANGE_ME
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_AGE_DAYS=90

# ─── Media processing ─────────────────────────────────────────────────────
UPLOAD_CHUNK_SIZE_MB=8
MAX_VIDEO_SIZE_GB=20
MAX_FILE_SIZE_MB=200
# Nginx body limit for file uploads — keep slightly above MAX_FILE_SIZE_MB
MAX_FILE_UPLOAD_SIZE=210m
KEEP_ORIGINAL_VIDEOS=false
HLS_RENDITIONS=360,720,1080
HLS_SEGMENT_SECONDS=6
FFMPEG_PRESET=veryfast
VIDEO_WORKER_CONCURRENCY=1
# CPU cores the transcoding worker may use
WORKER_CPUS=2

# Public Swagger UI at https://API_DOMAIN/api/docs (keep false in production unless needed)
ENABLE_API_DOCS=false

# ─── First super admin (used once by `npm run admin:create`) ─────────────
SEED_SUPER_ADMIN_NAME=مدير النظام
SEED_SUPER_ADMIN_PHONE=CHANGE_ME
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME

# ─── Backups ──────────────────────────────────────────────────────────────
BACKUP_HOST_DIR=./backups
BACKUP_TIME=02:30
VERIFY_EVERY_DAYS=7
KEEP_DAILY=14
KEEP_WEEKLY=8
KEEP_MONTHLY=12
