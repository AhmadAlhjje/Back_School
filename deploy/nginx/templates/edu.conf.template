# Rendered at container start: ${API_DOMAIN}, ${OWNER_DOMAIN}, ${ADMIN_DOMAIN} and
# ${MAX_FILE_UPLOAD_SIZE} come from backend/deploy/.env. Nginx variables ($host, ...) are left untouched.

# Dashboards allowed to read media cross-origin (owner/admin video preview through hls.js).
map $http_origin $media_cors_origin {
  default "";
  "https://${OWNER_DOMAIN}" $http_origin;
  "https://${ADMIN_DOMAIN}" $http_origin;
}

map $host $dashboard_csp {
  default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://${API_DOMAIN}; font-src 'self' data:; connect-src 'self' https://${API_DOMAIN}; media-src 'self' blob: https://${API_DOMAIN}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
}

# ─── Unknown hosts are dropped ────────────────────────────────────────────────
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  # Container health check (docker-compose.yml). Returns only "ok".
  location = /nginx-health {
    access_log off;
    return 200 "ok";
  }
  location / {
    return 444;
  }
}

server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  server_name _;
  ssl_reject_handshake on;
}

# ─── HTTP → HTTPS (and ACME HTTP-01 challenges) ───────────────────────────────
server {
  listen 80;
  listen [::]:80;
  server_name ${API_DOMAIN} ${OWNER_DOMAIN} ${ADMIN_DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

# ─── API ──────────────────────────────────────────────────────────────────────
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${API_DOMAIN};
  include /etc/nginx/snippets/tls.conf;

  client_max_body_size 16m;

  location /api/v1/auth/ {
    limit_req zone=auth burst=20 nodelay;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Resumable video upload chunks (UPLOAD_CHUNK_SIZE_MB, default 8 MB): streamed to the API.
  location ~ ^/api/v1/videos/[^/]+/upload/chunks/ {
    client_max_body_size 16m;
    proxy_request_buffering off;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Educational file uploads: one multipart request up to MAX_FILE_SIZE_MB (teacher photos are ≤ 5 MB).
  location = /api/v1/files {
    client_max_body_size ${MAX_FILE_UPLOAD_SIZE};
    proxy_request_buffering off;
    include /etc/nginx/snippets/proxy.conf;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
  }

  location /api/ {
    limit_req zone=api burst=100 nodelay;
    include /etc/nginx/snippets/proxy.conf;
  }

  location /health {
    include /etc/nginx/snippets/proxy.conf;
  }

  # Private media. Never reachable directly: only an authorizing API response carrying
  # `X-Accel-Redirect: /protected-media/<key>` makes Nginx stream the file (MEDIA_ACCEL_REDIRECT=true).
  # Content-Type, Content-Disposition and Cache-Control are taken from that API response.
  location /protected-media/ {
    internal;
    alias /var/lib/edu/storage/;
    add_header Access-Control-Allow-Origin $media_cors_origin always;
    add_header Vary Origin always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
  }

  location / {
    return 404;
  }
}

# ─── Institute owner dashboard ────────────────────────────────────────────────
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${OWNER_DOMAIN};
  include /etc/nginx/snippets/tls.conf;
  root /usr/share/nginx/owner;
  include /etc/nginx/snippets/spa.conf;
}

# ─── Super admin dashboard ────────────────────────────────────────────────────
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${ADMIN_DOMAIN};
  include /etc/nginx/snippets/tls.conf;
  # Optional hardening: only allow the administrator's networks, e.g.
  #   allow 203.0.113.0/24;
  #   deny all;
  root /usr/share/nginx/admin;
  include /etc/nginx/snippets/spa.conf;
}
